{
  "manifestId": "mp5-excerpts-v1",
  "version": 2,
  "description": "Excerpts deterministically extractable via ffmpeg -ss/-t from registered corpus sources. Default harness uses role=dev only. v2 repair: registered origami sources are 8.0 s each, so dev windows are the full 8 s source (v1 windows overran every source and emptied three excerpts). Tags describe the intended stress class of the chosen source segment.",
  "extract": {
    "tool": "ffmpeg",
    "args": ["-ss", "<startSec>", "-i", "<source>", "-t", "<durationSec>", "-f", "s16le", "-acodec", "pcm_s16le"]
  },
  "excerpts": [
